{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "filtron",
	"version": "1.0.0",
	"private": true,
	"description": "The monorepo for Filtron, a fast, human-friendly filter language designed for real-time APIs.",
	"homepage": "https://filtron.dev",
	"bugs": {
		"url": "https://github.com/jbergstroem/filtron/issues"
	},
	"license": "MIT",
	"author": "Johan Bergström <bugs@bergstroem.nu>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jbergstroem/filtron.git"
	},
	"workspaces": {
		"packages": [
			"packages/*",
			"examples/elysia-sqlite",
			"website"
		],
		"catalog": {
			"@types/bun": "1.4.4",
			"oxfmt": "0.73.0",
			"typescript": "7.0.2"
		}
	},
	"scripts": {
		"bench": "cd packages/core && bun run bench",
		"build": "bun run --filter '@filtron/core' build && bun run --filter '!@filtron/core' build",
		"lint": "bun check && oxlint --type-aware && bun fmt --check",
		"lint:fix": "bun check && oxlint --type-aware --fix && bun fmt",
		"knip": "knip",
		"website": "cd website && bun run dev"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"knip": "6.41.0",
		"oxfmt": "catalog:",
		"oxlint": "1.89.0",
		"oxlint-tsgolint": "7.0.2004"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"engines": {
		"bun": ">=1.2.19",
		"node": ">=22.0.0"
	},
	"packageManager": "bun@1.4.4"
}
